# ═══ إعدادات منصة «قارئ المدرسة» ═══
# انسخ هذا الملف باسم .env وعدّل القيم

NODE_ENV=production
PORT=3000
# رابط الموقع النهائي (بدون / في النهاية)
PUBLIC_URL=https://qari.example.com
# فعّله عند العمل خلف Nginx أو Cloudflare أو منصات الاستضافة (Render / Railway)
TRUST_PROXY=1

# مجلد قاعدة البيانات والملفات (يجب أن يكون على قرص دائم)
DATA_DIR=./data

# مفتاح سري طويل (64 حرفًا عشوائيًا على الأقل). إن تُرك فارغًا يُنشأ تلقائيًا داخل DATA_DIR
APP_SECRET=

# حساب المالك الأول — يُنشأ مرة واحدة عند أول تشغيل فقط، ثم احذف كلمة المرور من هنا
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ═══ التخزين ═══
# local = على قرص الخادم | s3 = تخزين سحابي متوافق مع S3 (Cloudflare R2 / AWS S3 / Backblaze B2 / Wasabi)
STORAGE_DRIVER=local
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=qari-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=qari/

# ═══ التصويت بحساب المدرسة (اختياري — OpenID Connect) ═══
# Google Workspace:   OIDC_ISSUER=https://accounts.google.com
# Microsoft 365:      OIDC_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# عنوان إعادة التوجيه الذي يُسجَّل عند المزوّد:  <PUBLIC_URL>/auth/school/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# قصر الدخول على نطاق بريد المدرسة
OIDC_ALLOWED_DOMAIN=school.edu.qa
OIDC_BUTTON_LABEL=الدخول بحساب المدرسة
